        "type": "dev.cdevents.deployment.recorded",
        "direction": "emit",
        "reconciliation": {
          "declared": false
        }
      },
      {
        "type": "dev.cdevents.deployment.requested",
        "direction": "emit",
        "reconciliation": {
          "declared": false
        }
      }
    ],
    "awaits": [
      {
        "type": "dev.cdevents.deployment",
        "mode": "resolved",
        "anchor": "deploy",
        "hash": "sha256:2df95742784d7474d12140bf220cb522a2f3919f8e49b25294fa3c06635f3c11"
      }
    ],
    "emits": [
      {
        "go": "deployment.DeploymentRecorded",
        "type": "dev.cdevents.deployment.recorded",
        "namespace": "dev.cdevents.deployment"
      },
      {
        "go": "deployment.Deploy",
        "type": "dev.cdevents.deployment.requested",
        "namespace": "dev.cdevents.deployment"
      }
    ],
    "exchanges": [
      {
        "seat": "history",
        "name": "history.last",
        "consumption": "inline",
        "chainRole": "main",
