{
  "schemaVersion": "koine.manifest/1",
  "kind": "station",
  "identity": {
    "group": "payment-engineering",
    "author": "mchen",
    "name": "deployment-rehearsal"
  },
  "claim": "dev.cdevents.deployment",
  "awaits": [
