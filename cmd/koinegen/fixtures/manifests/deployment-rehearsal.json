        "chainRole": "blocking",
        "returns": "dev.cdevents.deployment.recorded",
        "permissions": [
          "ledger:append"
        ]
      }
    ],
    "seats": [
      {
        "seat": "history",
        "tool": "record",
        "connection": "record-query",
        "permissions": [
          "record:read"
        ]
      },
      {
        "seat": "ledger",
        "tool": "ledger",
        "connection": "append-only",
        "permissions": [
          "ledger:append"
        ]
      }
    ]
  }
